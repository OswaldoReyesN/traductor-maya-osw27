# ============================================================================
# Traductor Maya — configuración. Copia este archivo a ".env" y llena los valores.
# ".env" NUNCA se sube a GitHub (está en .gitignore).
# Cambiar de cuenta de Azure = cambiar estos valores. No hay nada fijo en el código.
# ============================================================================

# --- Proveedor del modelo -----------------------------------------------------
# foundry = Microsoft Foundry con tu identidad (local: `az login`; Azure: identidad administrada)
# key     = endpoint de Azure OpenAI del recurso Foundry + API key
# fake    = modelo simulado sin costo (para probar la app)
LLM_PROVIDER=foundry

# Endpoint del proyecto (Foundry → Home → "Project endpoint")
FOUNDRY_PROJECT_ENDPOINT=https://<tu-recurso>.services.ai.azure.com/api/projects/<tu-proyecto>
# Solo si LLM_PROVIDER=key
AZURE_OPENAI_ENDPOINT=https://<tu-recurso>.openai.azure.com/
AZURE_OPENAI_API_KEY=

# Nombre del DESPLIEGUE del modelo para cada agente (pueden ser distintos)
ASSISTANT_MODEL=gpt-5-mini
TRANSLATOR_MODEL=gpt-5-mini

# --- Ahorro de tokens -----------------------------------------------------------
REASONING_EFFORT=minimal        # minimal | low | medium | high
MAX_OUTPUT_TOKENS=600           # tope por respuesta del modelo
HISTORY_TURNS=2                 # turnos previos que se reenvían al modelo
MAX_INPUT_CHARS=300             # largo máximo del mensaje del usuario

# --- A2A (agente a agente) ------------------------------------------------------
PORT=8000
# Vacío = el traductor vive en la misma app (http://127.0.0.1:$PORT/a2a/translator/)
TRANSLATOR_A2A_URL=
# Clave interna entre agentes. Genera una larga y aleatoria.
A2A_INTERNAL_KEY=cambia-esta-clave-interna

# --- Catálogo, idiomas e internet -------------------------------------------
CATALOG_PATH=data/catalogo.md
ENABLED_LANGS=es,maya            # agrega ",en" para reactivar inglés más adelante
# URLs (https) que el traductor consulta SOLO si la palabra no está en el catálogo.
# Vacío = sin internet. Varias URLs separadas por coma.
ALLOWED_SOURCES=https://pueblosoriginarios.com/lenguas/mayas.php

# --- Consumo y costo estimado ---------------------------------------------------
DATA_DIR=data/runtime           # en Azure App Service usa /home/data (persistente)
PRICE_INPUT_PER_1M=0.25         # USD por 1 millón de tokens de entrada (gpt-5-mini)
PRICE_OUTPUT_PER_1M=2.00        # USD por 1 millón de tokens de salida (gpt-5-mini)
PRICE_CURRENCY=USD

# --- Protección de tus créditos ------------------------------------------------
APP_ACCESS_KEY=cambia-esta-clave-de-acceso   # vacío = sin clave (no recomendado)
MAX_MESSAGES_PER_SESSION=30
MAX_TOKENS_PER_SESSION=40000
MAX_TOKENS_PER_DAY=300000
RATE_LIMIT_PER_MINUTE=8          # mensajes por minuto por IP (anti-bots)
RATE_LIMIT_PER_HOUR=60           # mensajes por hora por IP
